{
  "schema_version": 1,
  "components": {
    "tag_9": {
      "id": "nd_filter",
      "type": "OPTICAL_FILTER",
      "name": "ND Filter",
      "tag_id": "tag_9",
      "size": {
        "width": 62,
        "height": 62
      },
      "height_mm": 60,
      "properties": {
        "optical_density": 1.0,
        "transmission": 0.1
      },
      "motor_ids": [
        1,
        3
      ],
      "motor_controller": "wifi_stepper2",
      "capabilities": {
        "tunables": {
          "nominal_pose": {
            "widget": "TablePose"
          },
          "nominal_motor_positions": {
            "widget": "JsonInspector"
          },
          "teleop": {
            "widget": "TeleopJog",
            "step_mm": [
              0.5,
              2.0,
              10.0
            ],
            "step_deg": [
              0.5,
              2.0,
              10.0
            ]
          }
        },
        "measurables": {
          "motor_rotations": {
            "widget": "MotorRotationsReadout"
          },
          "last_optimization_score": {
            "widget": "NumberBadge",
            "format": ".3f"
          }
        },
        "telemetry": {},
        "primitives": [
          "MOVE_COMPONENT",
          "STORE_COMPONENT",
          "PLACE_FROM_STORAGE",
          "PICK_COMPONENT",
          "HOVER",
          "PLACE_FROM_HOVER",
          "RECORD_MEASURABLES",
          "MOVE_MOTOR",
          "MOTOR_SEND_HOME",
          "MOTOR_SET_ZERO",
          "OPTIMIZE",
          "SCAN_ROTATE_IN_PLACE",
          "START_TELEOP",
          "END_TELEOP",
          "TELEOP_JOG",
          "SET_MOTOR_SETPOINT"
        ]
      }
    },
    "tag_22": {
      "id": "cam_gripper_1",
      "type": "OPTICAL_CAMERA",
      "name": "Gripper Camera 1",
      "tag_id": "tag_22",
      "size": {
        "width": 62,
        "height": 62
      },
      "height_mm": 60,
      "properties": {
        "resolution": "1920x1080",
        "fov": 60
      },
      "capabilities": {
        "tunables": {
          "nominal_pose": {
            "widget": "TablePose"
          },
          "exposure_time_ms": {
            "widget": "FloatRange",
            "min": 10.0,
            "max": 1000.0,
            "default": 200.0,
            "unit": "ms"
          },
          "teleop": {
            "widget": "TeleopJog",
            "step_mm": [
              0.5,
              2.0,
              10.0
            ],
            "step_deg": [
              0.5,
              2.0,
              10.0
            ]
          }
        },
        "measurables": {
          "camera_image": {
            "widget": "ImageViewer",
            "format": "png"
          }
        },
        "telemetry": {
          "stream": {
            "widget": "MJPEGViewer",
            "url": "/api/components/{tag_id}/telemetry/stream"
          },
          "preview": {
            "widget": "JPEGPoll",
            "url": "/api/components/{tag_id}/telemetry/preview",
            "default_fps": 10
          }
        },
        "primitives": [
          "MOVE_COMPONENT",
          "STORE_COMPONENT",
          "PLACE_FROM_STORAGE",
          "PICK_COMPONENT",
          "HOVER",
          "PLACE_FROM_HOVER",
          "RECORD_MEASURABLES",
          "START_TELEOP",
          "END_TELEOP",
          "TELEOP_JOG",
          "SET_EXPOSURE"
        ]
      }
    },
