    "tag_9": {
      "id": "nd_filter",
      "type": "OPTICAL_FILTER",
      "name": "ND Filter",
      "tag_id": "tag_9",
      "size": {
        "width": 62,
        "height": 62
      },
      "height_mm": 60,
      "parameters": {
        "optical_density": 1.0,
        "transmission": 0.1
      },
      "capabilities": {
        "statecontrol": {
          "tunables": {
            "nominal_pose": {
              "widget": "TablePose",
              "recordable": true
            }
          },
          "measurables": {}
        },
        "telemetry": {
          "teleop": {
            "rz": {
              "widget": "TeleopRz",
              "step_deg": [
                0.5,
                2.0,
                10.0
              ]
            },
            "pose3d": {
              "widget": "TeleopPose3d",
              "step_mm": [
                0.5,
                2.0,
                10.0
              ],
              "step_deg": [
                0.5,
                2.0,
                10.0
              ],
              "step_z_mm": [
                1.0,
                5.0,
                20.0
              ]
            },
            "live_pose": {
              "widget": "LivePosePoll",
              "url": "/api/components/{tag_id}/telemetry/live-pose",
              "default_fps": 20
            }
          },
          "live_feed": {}
        },
        "primitives": [
          "MOVE_COMPONENT",
          "STORE_COMPONENT",
          "PLACE_FROM_STORAGE",
          "PICK_COMPONENT",
          "HOVER",
          "PLACE_FROM_HOVER",
          "RECORD_MEASURABLES",
          "START_TELEOP",
          "END_TELEOP",
          "TELEOP_GOTO",
          "RECORD_TUNABLES",
          "SYNC_RUNTIME",
          "LOCALIZE_COMPONENTS"
        ]
      }
    },
    "tag_22": {
      "id": "cam_gripper_1",
      "type": "OPTICAL_CAMERA",
      "name": "Gripper Camera 1",
      "tag_id": "tag_22",
      "size": {
        "width": 62,
        "height": 62
      },
      "height_mm": 175,
      "parameters": {
        "placeable_on_table": true,
        "resolution": "1920x1080",
        "fov": 60,
        "hardware_binding": {
          "backend": "recorder_tcp",
          "recorder_cam_id": 1,
          "recorder_port": 9999
        },
        "vision_device_index": 1
      },
      "capabilities": {
        "statecontrol": {
          "tunables": {
            "nominal_pose": {
              "widget": "TablePose",
              "recordable": true
            },
            "exposure_time_ms": {
              "widget": "FloatRange",
              "min": 10.0,
              "max": 1000.0,
              "default": 200.0,
              "unit": "ms",
              "recordable": true
            }
          },
          "measurables": {
            "camera_image": {
              "widget": "ImageViewer",
              "dtype": "uint8",
              "layout": "bgr_hwc_uint8",
              "domain": "spatial",
              "shape": "(H, W, 3)",
              "axes": {
                "H": "rows (y), pixels top\u2192bottom",
                "W": "cols (x), pixels left\u2192right",
                "3": "BGR channels (OpenCV / kernel layout)"
              },
              "wire_format": "png",
              "physical_interpretation": "Still frame from this camera. Kernels and lab.measurable(...).resolve() use BGR uint8 HxWx3; PNG is storage/wire only."
            }
          }
        },
        "telemetry": {
          "teleop": {
            "rz": {
              "widget": "TeleopRz",
              "step_deg": [
                0.5,
                2.0,
                10.0
              ]
            },
            "pose3d": {
              "widget": "TeleopPose3d",
              "step_mm": [
                0.5,
                2.0,
                10.0
              ],
              "step_deg": [
                0.5,
                2.0,
                10.0
              ],
              "step_z_mm": [
                1.0,
                5.0,
                20.0
              ]
            },
            "live_pose": {
              "widget": "LivePosePoll",
              "url": "/api/components/{tag_id}/telemetry/live-pose",
              "default_fps": 20
            }
          },
          "live_feed": {
            "stream": {
              "widget": "JPEGPoll",
              "url": "/api/components/{tag_id}/telemetry/preview",
              "default_fps": 20
            }
          }
        },
        "primitives": [
          "MOVE_COMPONENT",
          "SET_EXPOSURE",
          "STORE_COMPONENT",
          "PLACE_FROM_STORAGE",
          "PICK_COMPONENT",
          "HOVER",
          "PLACE_FROM_HOVER",
          "RECORD_MEASURABLES",
          "START_TELEOP",
          "END_TELEOP",
          "TELEOP_GOTO",
          "START_LIVE_FEED",
          "END_LIVE_FEED",
          "RECORD_TUNABLES",
          "SYNC_RUNTIME",
          "LOCALIZE_COMPONENTS"
        ]
      }
    },
