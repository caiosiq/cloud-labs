{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudlabs.local/schemas/edge_contract/v1/library.schema.json",
  "title": "EdgeLibraryV1",
  "description": "GET /library (and edge file data/library.json): the full component library for this lab. Every part the lab owns, whether or not it is currently tracked. Shape matches catalog v1 ({schema_version, components}). Cloud Labs validates types/widgets/primitives; the lab authors the instances.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "components"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Library document version (aligned with catalog v1)."
    },
    "backend_id": {
      "type": "string",
      "minLength": 1,
      "description": "Optional stamp when served over HTTP; may be omitted on disk."
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/libraryComponent" }
    }
  },
  "$defs": {
    "libraryComponent": {
      "type": "object",
      "required": ["id", "type", "tag_id", "capabilities"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable part identity within the lab (not necessarily unique globally)."
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Cloud Labs component type token (e.g. OPTICAL_MIRROR, OPTICAL_CAMERA)."
        },
        "tag_id": {
          "type": "string",
          "minLength": 1,
          "description": "Must equal the key under components."
        },
        "name": { "type": "string" },
        "size": {
          "type": "object",
          "properties": {
            "width": { "type": "number" },
            "height": { "type": "number" }
          },
          "additionalProperties": true
        },
        "height_mm": { "type": "number" },
        "parameters": {
          "type": "object",
          "additionalProperties": true,
          "description": "Static identity / hardware binding (marker_length, recorder_cam_id, …)."
        },
        "capabilities": {
          "type": "object",
          "required": ["primitives"],
          "additionalProperties": true,
          "properties": {
            "primitives": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "statecontrol": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "tunables": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/$defs/tunableDescriptor" },
                  "description": "Per-tunable widgets; recordable / set_at_init for SYNC_RUNTIME."
                },
                "measurables": { "type": "object", "additionalProperties": true }
              }
            },
            "telemetry": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "tunableDescriptor": {
      "type": "object",
      "required": ["widget"],
      "additionalProperties": true,
      "properties": {
        "widget": { "type": "string", "minLength": 1 },
        "recordable": {
          "type": "boolean",
          "description": "If true, RECORD_TUNABLES / SYNC_RUNTIME may overwrite from the world. If false/omitted (except nominal_pose default true), set_at_init is required."
        },
        "set_at_init": {
          "description": "Required when recordable is false: standard value applied during SYNC_RUNTIME."
        },
        "physical_interpretation": { "type": "string" },
        "unit": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "default": {}
      }
    }
  }
}
