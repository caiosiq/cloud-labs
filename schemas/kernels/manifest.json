{
  "schema_version": 1,
  "kernels": [
    {
      "id": "builtin.beam_com",
      "label": "Beam CoM (full frame)",
      "artifact": "builtin_beam_com.pt",
      "runtime": "torchscript",
      "output_kind": "features",
      "feature_names": [
        "cx",
        "cy",
        "peak"
      ],
      "description": "Full-frame unweighted geometric centroid of the brightest ~0.5% of pixels (faint-beam safe) as [cx, cy, peak]. Use with signed_axis_offset vs origin / axis / direction.",
      "backend": "any",
      "phase": "production",
      "hooks": [
        "evaluate",
        "capture",
        "tensor"
      ]
    },
    {
      "id": "builtin.beam_power",
      "label": "Beam power features",
      "artifact": "builtin_beam_power.pt",
      "runtime": "torchscript",
      "output_kind": "features",
      "feature_names": [
        "flux_above_background",
        "peak",
        "saturated_fraction"
      ],
      "description": "Power proxy; saturation channel mandatory for closed loop.",
      "backend": "any",
      "phase": "production",
      "hooks": [
        "evaluate",
        "capture",
        "tensor"
      ]
    },
    {
      "id": "builtin.beam_shift",
      "label": "Beam shift from FOV center",
      "artifact": "builtin_beam_shift.pt",
      "runtime": "torchscript",
      "output_kind": "features",
      "feature_names": [
        "dx",
        "dy",
        "magnitude"
      ],
      "description": "Unweighted geometric-centroid offset from this frame's center (W/2, H/2) as [dx, dy, magnitude] in px \u2014 resolution-agnostic, no reference capture. Maximize shift with weight=-1 on minimize_value(feature_index=2).",
      "backend": "any",
      "phase": "production",
      "hooks": [
        "evaluate",
        "capture",
        "tensor"
      ]
    },
    {
      "id": "builtin.gaussian_beam_fit",
      "label": "Gaussian beam moments",
      "artifact": "builtin_gaussian_beam_fit.pt",
      "runtime": "torchscript",
      "backend": "any",
      "phase": "production",
      "output_kind": "features",
      "feature_names": [
        "amplitude",
        "cx",
        "cy",
        "sigma_x",
        "sigma_y"
      ],
      "hooks": [
        "evaluate",
        "capture",
        "tensor"
      ],
      "inputs": [
        {
          "name": "image",
          "from": "measurables.camera_image",
          "layout": "bgr_hwc_uint8"
        }
      ],
      "outputs": [
        {
          "name": "features",
          "role": "features",
          "shape": [
            5
          ],
          "feature_names": [
            "amplitude",
            "cx",
            "cy",
            "sigma_x",
            "sigma_y"
          ]
        }
      ],
      "description": "Unweighted mask moments (median_bg + 5% of peak\u2212bg): amplitude, geometric centroid, and spatial widths."
    },
    {
      "id": "builtin.roi_centroid",
      "label": "ROI centroid (full frame)",
      "artifact": "builtin_roi_centroid.pt",
      "runtime": "torchscript",
      "backend": "any",
      "phase": "production",
      "output_kind": "features",
      "feature_names": [
        "cx",
        "cy",
        "peak"
      ],
      "hooks": [
        "evaluate",
        "capture",
        "tensor"
      ],
      "inputs": [
        {
          "name": "image",
          "from": "measurables.camera_image",
          "layout": "bgr_hwc_uint8"
        }
      ],
      "outputs": [
        {
          "name": "features",
          "role": "features",
          "shape": [
            3
          ],
          "feature_names": [
            "cx",
            "cy",
            "peak"
          ]
        }
      ],
      "description": "Unweighted geometric centroid over the full frame; mask is median_bg + 5% of (peak\u2212bg), plus full-frame peak for presence."
    },
    {
      "id": "demo.image_mean_score",
      "label": "Demo image mean score",
      "artifact": "demo_image_mean_score.pt",
      "runtime": "torchscript",
      "backend": "any",
      "phase": "production",
      "output_kind": "scalar",
      "hooks": [
        "evaluate",
        "capture",
        "tensor"
      ],
      "inputs": [
        {
          "name": "image",
          "from": "measurables.camera_image",
          "layout": "bgr_hwc_uint8"
        }
      ],
      "outputs": [
        {
          "name": "score",
          "role": "scalar"
        }
      ],
      "description": "Teaching scalar: mean intensity after RGB float normalize."
    },
    {
      "id": "demo.peak_intensity",
      "label": "Demo peak intensity",
      "artifact": "demo_peak_intensity.pt",
      "runtime": "torchscript",
      "backend": "any",
      "phase": "production",
      "output_kind": "scalar",
      "hooks": [
        "evaluate",
        "capture",
        "tensor"
      ],
      "inputs": [
        {
          "name": "image",
          "from": "measurables.camera_image",
          "layout": "bgr_hwc_uint8"
        }
      ],
      "outputs": [
        {
          "name": "score",
          "role": "scalar"
        }
      ],
      "description": "Maximum channel intensity in the normalized RGB frame (max over C,H,W). Tracks the brightest pixel \u2014 a crude peak-power proxy for mock demos."
    },
    {
      "id": "demo.roi_mean_score",
      "label": "Demo center ROI mean",
      "artifact": "demo_roi_mean_score.pt",
      "runtime": "torchscript",
      "backend": "any",
      "phase": "production",
      "output_kind": "scalar",
      "hooks": [
        "evaluate",
        "capture",
        "tensor"
      ],
      "inputs": [
        {
          "name": "image",
          "from": "measurables.camera_image",
          "layout": "bgr_hwc_uint8"
        }
      ],
      "outputs": [
        {
          "name": "score",
          "role": "scalar"
        }
      ],
      "description": "Mean intensity over the center-half ROI."
    }
  ]
}
